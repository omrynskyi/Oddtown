# Copy to .env. docker compose and the platform code both read it.

# local (one process), http (separate processes, no Docker) or slim
TRANSPORT=slim
# memory (one process), file (separate processes, no Docker) or agntcy
REGISTRY=agntcy

SLIM_ENDPOINT=http://localhost:46357
SLIM_SHARED_SECRET=oddtown-local-dev-shared-secret-change-me

# Host port for the Directory API. Change both if 8888 is taken.
DIRECTORY_PORT=8888
DIRECTORY_ADDRESS=localhost:8888

# Only for REGISTRY=file
REGISTRY_DIR=.oddtown/registry

# Observer (Oleg) and world service ports. The UI expects these.
OBSERVER_URL=http://localhost:8100
WORLD_PORT=8200

# LLM keys go here once the team picks models.
