# Copy to .env. docker compose and the platform code both read it.

# local (one process), http (separate processes, no Docker) or slim
TRANSPORT=slim
# memory (one process), file (separate processes, no Docker) or agntcy
REGISTRY=agntcy

SLIM_ENDPOINT=http://localhost:46357
SLIM_SHARED_SECRET=oddtown-local-dev-shared-secret-change-me

# Host port for the Directory API. Change both if 8888 is taken.
DIRECTORY_PORT=8888
DIRECTORY_ADDRESS=localhost:8888

# Only for REGISTRY=file
REGISTRY_DIR=.oddtown/registry

# Observer (Oleg) and world service ports. The UI expects these.
OBSERVER_URL=http://localhost:8100
WORLD_PORT=8200

# Agent brain (Anthony). Characters inherit the world service's environment,
# so export these in the shell that starts it: set -a && source .env && set +a
# mock runs the whole town with no API key. Remove it to use each persona's model (big-pickle).
ODDTOWN_MODEL=mock
# OpenCode Zen key for big-pickle. Free for now, and OpenCode may use the data to improve the model.
OPENCODE_API_KEY=
# A local Ollama instead of OpenCode Zen. Thinking models need reasoning off, or a call takes 25+ seconds.
# ODDTOWN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ODDTOWN_MODEL=qwen3.6:35b
# ODDTOWN_MODELS=qwen3.6:35b,big-pickle
# ODDTOWN_REASONING_EFFORT=none
# Only if a persona names a Claude model (add it to ODDTOWN_MODELS too).
# ANTHROPIC_API_KEY=
# 1.0 is real time. 0.1 makes waits and wall-clock lifespans 10x shorter for rehearsals.
ODDTOWN_TIME_SCALE=1.0
